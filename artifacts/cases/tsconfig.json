{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Shared permission model (lib/access); vite.config.ts has the
      // matching resolve.alias for runtime imports.
      "@cases/access": ["../../lib/access/src/index.ts"]
    },
    "outDir": "dist"
  },
  "include": ["src"]
}
