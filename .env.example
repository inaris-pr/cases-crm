# API server port (defaults to 3001 if unset). Vite dev server proxies /api here.
PORT=3001

# Frontend dev server port (defaults to 5173).
VITE_PORT=5173

# ── Network exposure ─────────────────────────────────────────────────────────
# Both servers listen on this machine only by default. Set to 0.0.0.0 only
# when you deliberately want other devices (or a cloud IDE) to reach them.
# API_HOST=127.0.0.1
# VITE_HOST=127.0.0.1

# ── Sign-in sessions (see artifacts/api-server/src/config.ts) ───────────────
# SESSION_IDLE_TIMEOUT_MINUTES=480      # 8 hours without a request ends a session
# SESSION_ABSOLUTE_TIMEOUT_DAYS=7       # hard limit after login
# SESSION_COOKIE_SECURE=auto            # auto | always | never (auto = Secure over HTTPS)

# ── Login throttling ────────────────────────────────────────────────────────
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_THROTTLE_WINDOW_MINUTES=15

# ── Trusted frontend origins (CSRF / same-origin check) ─────────────────────
# Browser origins of the app's own frontend when it reaches the API through a
# proxy. The Vite dev server proxies /api with changeOrigin, so the API sees
# its own Host (127.0.0.1:3001) while the browser's Origin is the dev server's.
# Exact origins only (scheme://host:port); no wildcards. Unset = the two below;
# set to an empty value to trust none. Change if you move the dev server port.
# TRUSTED_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Cross-origin access ─────────────────────────────────────────────────────
# Same-origin only by default: no CORS headers are sent.
# Comma-separated list of extra origins allowed to call the API cross-origin
# with cookies (these also pass the same-origin check).
# CORS_ALLOWED_ORIGINS=https://crm.example.com

# Optional: a Postgres connection string. The default backend uses an
# in-memory store and ignores this — it's just here for when you swap in
# the Drizzle implementation under lib/db.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cases
